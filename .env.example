# ---- Supabase (Project Settings -> API) --------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Auth (pick-name + pool password model) ----------------------------------
# Shared password every member types to enter the pool.
POOL_PASSWORD=change-me
# Extra PIN that unlocks admin actions (entering results, managing the pot).
ADMIN_PIN=1234
# Random 32+ char secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
