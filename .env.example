# ---- Supabase (Project Settings -> API) --------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Auth (pick-name + pool password model) ----------------------------------
# Shared password every member types to enter the pool.
POOL_PASSWORD=change-me
# Extra PIN that unlocks admin actions (entering results, managing the pot).
ADMIN_PIN=1234
# Random 32+ char secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Automatic results sync -------------------------------------------------
# Protects the /api/sync cron endpoint. Vercel Cron sends it as a Bearer token.
# Generate with: openssl rand -hex 16
CRON_SECRET=change-me
# Optional: override the results data source (defaults to the openfootball 2026 feed).
# SYNC_SOURCE_URL=https://raw.githubusercontent.com/openfootball/worldcup.json/master/2026/worldcup.json
